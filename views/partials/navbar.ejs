<nav style="background:#333; color:#fff; padding:10px 20px; display:flex; align-items:center; justify-content:space-between;">
  <a href="/blogs" style="color:#fff; font-size:1.3rem; font-weight:bold; text-decoration:none;">📝 BlogApp</a>
  <div style="display:flex; gap:14px; align-items:center;">
    <a href="/blogs" style="color:#fff; text-decoration:none;">All Blogs</a>
    <% if (user) { %>
      <a href="/dashboard" style="color:#fff; text-decoration:none;">Dashboard</a>
      <a href="/blogs/create" style="color:#fff; text-decoration:none;">+ New Blog</a>
      <% if (user.role === 'admin') { %>
        <a href="/users" style="color:#ffc107; text-decoration:none;">👥 Users</a>
      <% } %>
      <span style="color:#aaa;">| <%= user.name %> (<%= user.role %>)</span>
      <a href="/api/auth/logout" style="color:#ff6b6b; text-decoration:none;">Logout</a>
    <% } else { %>
      <a href="/login" style="color:#fff; text-decoration:none;">Login</a>
      <a href="/register" style="color:#fff; text-decoration:none;">Register</a>
    <% } %>
  </div>
</nav>
