<%- include('../partials/header') %>

<div style="max-width:800px; margin:40px auto; padding:0 16px;">
  <% if (blog.image) { %>
    <img src="/uploads/<%= blog.image %>" alt="<%= blog.title %>"
      style="width:100%; max-height:400px; object-fit:cover; border-radius:8px; margin-bottom:24px;"/>
  <% } %>

  <h1 style="margin-bottom:8px;"><%= blog.title %></h1>

  <p style="color:#777; margin-bottom:24px; font-size:0.95rem;">
    By <strong><%= blog.author ? blog.author.name : 'Unknown' %></strong>
    &middot; <%= blog.createdAt.toDateString() %>
    <% if (blog.updatedAt && blog.updatedAt.getTime() !== blog.createdAt.getTime()) { %>
      &middot; <em>Updated: <%= blog.updatedAt.toDateString() %></em>
    <% } %>
  </p>

  <hr/>

  <div style="line-height:1.8; font-size:1.05rem; white-space:pre-wrap; margin:24px 0;">
    <%= blog.content %>
  </div>

  <hr style="margin-top:32px;"/>

  <div style="display:flex; gap:12px; margin-top:16px; flex-wrap:wrap;">
    <a href="/blogs" style="padding:8px 18px; border:1px solid #ccc; border-radius:4px; text-decoration:none; color:#333;">
      ← All Blogs
    </a>

    <% if (user && (user.role === 'admin' || (blog.author && blog.author._id.toString() === user._id.toString()))) { %>
      <a href="/blogs/edit/<%= blog._id %>"
        style="padding:8px 18px; background:#333; color:#fff; border-radius:4px; text-decoration:none;">
        ✏️ Edit
      </a>

      <form action="/blogs/delete/<%= blog._id %>" method="POST" style="display:inline;"
        onsubmit="return confirm('Are you sure you want to delete this blog?')">
        <button type="submit"
          style="padding:8px 18px; background:#dc3545; color:#fff; border:none; border-radius:4px; cursor:pointer;">
          🗑️ Delete
        </button>
      </form>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
