<%- include('../partials/header') %>

<div style="max-width:700px; margin:40px auto; padding:0 16px;">
  <h2>✏️ Edit Blog</h2>

  <form action="/blogs/edit/<%= blog._id %>" method="POST" enctype="multipart/form-data">
    <div style="margin-bottom:16px;">
      <label for="title"><strong>Title</strong></label><br/>
      <input type="text" id="title" name="title" value="<%= blog.title %>" required
        style="width:100%; padding:8px; margin-top:4px; box-sizing:border-box; font-size:1rem;"/>
    </div>

    <div style="margin-bottom:16px;">
      <label for="content"><strong>Content</strong></label><br/>
      <textarea id="content" name="content" rows="10" required
        style="width:100%; padding:8px; margin-top:4px; box-sizing:border-box; font-size:1rem; resize:vertical;"><%= blog.content %></textarea>
    </div>

    <div style="margin-bottom:20px;">
      <label><strong>Blog Image</strong></label><br/>
      <% if (blog.image) { %>
        <p style="margin:6px 0; font-size:0.9rem; color:#555;">Current image:</p>
        <img src="/uploads/<%= blog.image %>" alt="current image"
          style="width:200px; height:130px; object-fit:cover; display:block; margin-bottom:8px; border:1px solid #ddd; border-radius:4px;"/>
      <% } %>
      <label for="image" style="font-size:0.9rem; color:#555;"><%= blog.image ? 'Replace image:' : 'Upload image (optional):' %></label><br/>
      <input type="file" id="image" name="image" accept="image/*" style="margin-top:4px;"/>
    </div>

    <div style="display:flex; gap:12px;">
      <button type="submit"
        style="padding:10px 24px; background:#333; color:#fff; border:none; border-radius:4px; cursor:pointer; font-size:1rem;">
        Update Blog
      </button>
      <a href="/blogs/<%= blog._id %>" style="padding:10px 20px; border:1px solid #ccc; border-radius:4px; text-decoration:none; color:#333;">
        Cancel
      </a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
