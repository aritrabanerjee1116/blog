<%- include('../partials/header') %>

<div style="max-width:700px; margin:40px auto; padding:0 16px;">
  <h2>📝 Create New Blog</h2>

  <form action="/api/blogs" method="POST" enctype="multipart/form-data">
    <div style="margin-bottom:16px;">
      <label for="title"><strong>Title</strong></label><br/>
      <input type="text" id="title" name="title" placeholder="Blog title" required
        style="width:100%; padding:8px; margin-top:4px; box-sizing:border-box; font-size:1rem;"/>
    </div>

    <div style="margin-bottom:16px;">
      <label for="content"><strong>Content</strong></label><br/>
      <textarea id="content" name="content" rows="10" placeholder="Write your blog content here..." required
        style="width:100%; padding:8px; margin-top:4px; box-sizing:border-box; font-size:1rem; resize:vertical;"></textarea>
    </div>

    <div style="margin-bottom:20px;">
      <label for="image"><strong>Blog Image</strong> (optional)</label><br/>
      <input type="file" id="image" name="image" accept="image/*" style="margin-top:4px;"/>
    </div>

    <div style="display:flex; gap:12px;">
      <button type="submit"
        style="padding:10px 24px; background:#333; color:#fff; border:none; border-radius:4px; cursor:pointer; font-size:1rem;">
        Publish Blog
      </button>
      <a href="/blogs" style="padding:10px 20px; border:1px solid #ccc; border-radius:4px; text-decoration:none; color:#333;">
        Cancel
      </a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
